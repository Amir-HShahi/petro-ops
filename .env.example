# Copy to .env and fill in real values. Keep this file in sync with .env.

# Folder for the submitted source files.
# Relative to the directory the core is started in. It is gitignored.
DATA_DIR=data

# The local Postgres server as a libpq URL. Only loopback hosts are accepted (ADR 0005).
# The user, password and port 55432 match docker/docker-compose.yml.
DATABASE_URL=postgresql://petro_ops:petro_ops@127.0.0.1:55432/petro_ops

# The most database connections one process keeps open.
DATABASE_POOL_SIZE=5

# How long to wait for a database connection, in seconds.
DATABASE_CONNECT_TIMEOUT_S=5

# How long the outbox relay waits between two passes, in seconds.
OUTBOX_POLL_INTERVAL_S=2

# How long a queued ingestion may wait after its last message before the reconciler
# sends a new one, in seconds. Keep it above the longest expected queue wait.
RECONCILE_AFTER_S=1800

# The local RabbitMQ broker as an AMQP URL. Only loopback hosts are accepted (ADR 0005).
# The user and password match docker/docker-compose.yml.
RABBITMQ_URL=amqp://petro_ops:petro_ops@127.0.0.1:5672/%2F

# RabbitMQ's management HTTP API with its user and password, read for the queue
# counts on the pipeline page. Only loopback hosts are accepted (ADR 0008).
RABBITMQ_MANAGEMENT_URL=http://petro_ops:petro_ops@127.0.0.1:15672

# How many unacked messages one worker holds at once.
WORKER_PREFETCH_COUNT=1

# How many times a worker step is tried before its ingestion fails and the
# message goes to the dead-letter queue.
WORKER_MAX_ATTEMPTS=3

# How long a failed step waits in the retry queue before it runs again, in seconds.
WORKER_RETRY_DELAY_S=30

# The address the ingestion API listens on. Only loopback addresses are accepted;
# the API has no authentication (ADR 0006).
API_HOST=127.0.0.1

# The TCP port the ingestion API listens on, 1 to 65535.
API_PORT=8000

# The largest file that can be submitted, in megabytes.
MAX_FILE_MB=50

# CSV file of Nodes that `organization import-nodes` registers by default (spec §6.1).
NODE_REGISTRY_PATH=fixtures/registry/nodes.csv

# Lowest log level that is written: debug, info, warning or error.
LOG_LEVEL=info

# A PDF page with fewer non-space characters than this has no usable text
# layer, so the LVM reads it instead. Counted in characters.
MIN_PAGE_TEXT_CHARS=20

# The LibreOffice program that converts legacy DOC files: a name on PATH or a full path.
LIBREOFFICE_PATH=soffice

# How long one DOC conversion may take, in seconds.
DOC_CONVERSION_TIMEOUT_S=120

# Folder with Docling's layout and table-structure models, loaded only from here.
# Fill it with: docling-tools models download layout tableformer -o models/docling
DOCLING_MODELS_DIR=models/docling

# The local Ollama server. Only loopback addresses are accepted (ADR 0001).
OLLAMA_URL=http://127.0.0.1:11434

# How long one model request may take, in seconds. The first one also loads the model.
MODEL_TIMEOUT_S=300

# Resolution of page images for the vision models, in dots per inch.
PAGE_RENDER_DPI=150

# How often the LVM is asked before a malformed answer counts as a failure.
LVM_MAX_ATTEMPTS=2

# The folder with prompts/registry.yaml and the prompt templates.
PROMPTS_DIR=prompts

# The file that names the model of each role.
MODEL_MANIFEST_PATH=models/manifest.yaml

# Target size of a knowledge chunk, in tokens (estimated, about 4 characters each).
CHUNK_TARGET_TOKENS=400

# Hard limit for a knowledge chunk, in tokens. At least CHUNK_TARGET_TOKENS and
# below 2048, the embedding model's context; keep it well below.
CHUNK_MAX_TOKENS=512

# Share of the previous chunk repeated at the start of the next one in the same
# section, from 0 to 0.5.
CHUNK_OVERLAP_SHARE=0.12

# Words per shingle when comparing chunk text for duplicates and overlap.
DUPLICATE_SHINGLE_WORDS=12

# Share of a chunk's shingles, from 0 to 1, found in another item of the same Node
# at or above which the chunk counts as overlapping that item.
OVERLAP_CHUNK_SIMILARITY=0.40

# Lower share, from 0 to 1, from which a chunk counts towards an ambiguous overlap.
# Must be below OVERLAP_CHUNK_SIMILARITY.
OVERLAP_AMBIGUOUS_FROM_SIMILARITY=0.25

# Share of a version's chunks, from 0 to 1, that must overlap another item for
# an overlap flag.
OVERLAP_MIN_CHUNK_SHARE=0.20

# Word similarity, from 0 to 1, of a new Issue's title and description to an Issue of
# the same Node, from which it is flagged as a likely duplicate (ADR 0012).
SIMILAR_ISSUE_DUPLICATE_FROM=0.40

# Lower word similarity, from 0 to 1, from which a new Issue is flagged as overlapping
# an Issue of its Node. Must be below SIMILAR_ISSUE_DUPLICATE_FROM.
SIMILAR_ISSUE_OVERLAP_FROM=0.25
