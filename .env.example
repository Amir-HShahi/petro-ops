# Copy to .env and fill in real values. Keep this file in sync with .env.

# Folder for the submitted source files.
# Relative to the directory the core is started in. It is gitignored.
DATA_DIR=data

# The local Postgres server as a libpq URL. Only loopback hosts are accepted (ADR 0005).
# The user and password here are placeholders for the local docker compose service.
DATABASE_URL=postgresql://petro_ops:petro_ops@127.0.0.1:5432/petro_ops

# The most database connections one process keeps open.
DATABASE_POOL_SIZE=5

# How long to wait for a database connection, in seconds.
DATABASE_CONNECT_TIMEOUT_S=5

# CSV file with the registered Nodes (spec §6.1).
NODE_REGISTRY_PATH=fixtures/registry/nodes.csv

# Lowest log level that is written: debug, info, warning or error.
LOG_LEVEL=info

# A PDF page with fewer non-space characters than this has no usable text
# layer, so the LVM reads it instead. Counted in characters.
MIN_PAGE_TEXT_CHARS=20

# The LibreOffice program that converts legacy DOC files: a name on PATH or a full path.
LIBREOFFICE_PATH=soffice

# How long one DOC conversion may take, in seconds.
DOC_CONVERSION_TIMEOUT_S=120

# The local Ollama server. Only loopback addresses are accepted (ADR 0001).
OLLAMA_URL=http://127.0.0.1:11434

# How long one model request may take, in seconds. The first one also loads the model.
MODEL_TIMEOUT_S=300

# Resolution of page images for the vision models, in dots per inch.
PAGE_RENDER_DPI=150

# How often the LVM is asked before a malformed answer counts as a failure.
LVM_MAX_ATTEMPTS=2

# The folder with prompts/registry.yaml and the prompt templates.
PROMPTS_DIR=prompts

# The file that names the model of each role.
MODEL_MANIFEST_PATH=models/manifest.yaml
